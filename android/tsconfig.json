{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "strict": true,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "noEmit": true,
        "types": []
    },
    "include": ["src"]
}
